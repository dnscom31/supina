.steps { display: flex; justify-content: space-around; padding: 12px 0; border-bottom: 1px solid var(--border); background: var(--card-bg); position: sticky; top: 0; z-index: 10; }
.step { display: flex; flex-direction: column; align-items: center; cursor: pointer; transition: color 0.2s, transform 0.2s; }
.step .num { width: 30px; height: 30px; line-height: 30px; border-radius: 50%; background: var(--border); color: var(--text); display: flex; align-items: center; justify-content: center; margin-bottom: 4px; font-weight: bold; }
.step.active .num { background: var(--primary); color: #fff; }
.step .label { font-size: 12px; color: var(--muted); }
.step.active .label { color: var(--primary); }
.step.disabled { pointer-events: none; opacity: 0.5; }

.step-panel { background: var(--card-bg); border: 1px solid var(--border); border-radius: 14px; padding: 16px; box-shadow: var(--shadow); display: none; position: relative; }
.step-panel.active { display: block; }
.step-panel h2 { margin-top: 0; font-size: 18px; color: var(--secondary); }

.side-buttons { display: flex; gap: 12px; margin: 12px 0; }
.paint-tools { display: flex; align-items: center; gap: 12px; margin: 12px 0; flex-wrap: wrap; }
.paint-tools label { font-size: 14px; color: var(--text); display: flex; align-items: center; gap: 4px; }
.paint-tools input[type="range"] { width: 120px; }
.paint-tools button { background: var(--border); border: none; padding: 8px 12px; border-radius: 8px; cursor: pointer; color: var(--text); font-size: 14px; transition: background 0.2s; }
.paint-tools button.primary { background: var(--primary); color: #fff; }
.paint-tools button.ghost { background: transparent; border: 1px dashed var(--border); }
.paint-tools button:hover { background: var(--secondary); color: #fff; }

.sliders { display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px; }
.sliders label { display: flex; align-items: center; gap: 8px; font-size: 14px; }
.sliders input[type="range"] { flex: 1; }

.nudge { display: grid; grid-template-columns: repeat(3, 40px); gap: 4px; justify-content: center; margin-top: 8px; }
.nudge button { width: 40px; height: 40px; border: 1px solid var(--border); background: var(--card-bg); border-radius: 6px; cursor: pointer; font-size: 18px; }
.nudge button:nth-child(1) { grid-column: 1; grid-row: 2; }
.nudge button:nth-child(2) { grid-column: 3; grid-row: 2; }
.nudge button:nth-child(3) { grid-column: 2; grid-row: 1; }
.nudge button:nth-child(4) { grid-column: 2; grid-row: 3; }

/* 레이아웃 */
.step2-container, .step4-container, .brow-container { display: flex; gap: 16px; align-items: flex-start; flex-wrap: wrap; }
.step2-container .controls { flex: 0 0 360px; }
.step2-container .preview { flex: 1; min-width: 300px; }
.brow-container .controls { flex: 0 0 200px; }
.brow-container .preview { flex: 1; min-width: 200px; }
.step4-container { align-items: flex-start; }
.step4-container .controls { flex: 1 1 0; max-width: 35%; }
.step4-container .preview  { flex: 0 0 65%; max-width: 65%; min-width: 700px; }
.step4-container .preview canvas, .step4-container .preview img { width: 100%; height: auto; display: block; }

.defaults-toolbar .secondary { padding: 6px 10px; border-radius: 8px; background: #ececec; border: none; cursor: pointer; }
.defaults-toolbar .secondary:hover { background: #ddd; }
.tag { display: inline-block; padding: 2px 6px; border-radius: 6px; background: rgba(0,0,0,.06); color: var(--secondary); font-size: 12px; margin-right: 6px; }


/* 고정 그리드 오버레이 (줌/이동에 영향받지 않음) */
.canvas-group .static-grid {
  z-index: 0;
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.25;
  background-image:
    linear-gradient(to right, rgba(0,0,0,.08) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(0,0,0,.08) 1px, transparent 1px);
  background-size: 20px 20px; /* 그리드 간격 */
}
/* 우상단 확대 UI */
.canvas-group .zoom-ui {
  position: absolute;
  top: 8px;
  right: 8px;
  display: flex;
  gap: 6px;
  z-index: 5;
}
.canvas-group .zoom-ui button {
  padding: 6px 10px;
  border: 1px solid var(--border);
  background: var(--card-bg);
  border-radius: 8px;
  cursor: pointer;
}
/* 캔버스는 겹쳐서 렌더링 */
.canvas-group canvas {
  position: relative;
  z-index: 1;
}
/* 미리보기 영역 넓히기: Step2 */
.step2-container .preview { flex: 1; min-width: 600px; }
